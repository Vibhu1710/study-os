# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
next-env.d.ts

# Production / build artifacts
/build
/dist
*.tsbuildinfo

# Testing
/coverage

# Environment and secrets (never commit)
.env
.env.*
!.env.example

# Vercel / hosting
.vercel

# Local SQLite database and WAL sidecars (each developer gets their own)
/data/
*.db
*.db-shm
*.db-wal

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors / IDE (personal settings stay local)
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Cursor (local agent/editor state)
.cursor/

# Drizzle Kit local artifacts (if generated outside /data)
/drizzle/meta/

# Misc certificates
*.pem
